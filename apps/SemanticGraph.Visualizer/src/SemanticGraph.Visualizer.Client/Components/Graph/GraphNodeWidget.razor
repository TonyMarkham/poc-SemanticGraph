@using Blazor.Diagrams.Components.Renderers

<div class="@CssClass" title="@Node.View.Tooltip">
    <div class="node-kind">@Node.View.Kind</div>
    <div class="node-label">@Node.View.DisplayLabel</div>
    @if (!string.IsNullOrWhiteSpace(Node.View.SourceFilePath))
    {
        <div class="node-path">@Node.View.SourceFilePath</div>
    }
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port" Class="semantic-port" />
    }
</div>

@code {
    [Parameter]
    public SemanticGraphNodeModel Node { get; set; } = null!;

    private string CssClass
    {
        get
        {
            var nodeKindClass = Node.View.IsFile
                ? "file-node"
                : $"symbol-node relation-{Node.View.KindCssClass}";
            var selectedClass = Node.Selected ? " is-selected" : string.Empty;
            var relatedClass = Node.IsRelatedEndpoint ? " is-related-endpoint" : string.Empty;

            return $"semantic-node {nodeKindClass}{selectedClass}{relatedClass}";
        }
    }
}
